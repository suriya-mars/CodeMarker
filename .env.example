LLM_PROVIDER=anthropic            # or: openai
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_MODEL=                     # set to your current OpenAI model if LLM_PROVIDER=openai (e.g. gpt-4o-mini)
NEO4J_PASSWORD=change-me           # REQUIRED: replace. The api refuses this placeholder.

# Authentication for the HTTP API (api/auth.py).
#   none  - local development only; every route is open
#   token - send "Authorization: Bearer $API_TOKEN" (min 32 chars)
#   alb   - production behind an AWS ALB with Cognito login; set ALB_ARN
AUTH_MODE=none
API_TOKEN=
ALB_ARN=                          # arn:aws:elasticloadbalancing:<region>:<acct>:loadbalancer/app/<name>/<id>
# Exact origins allowed to call the API cross-origin. Leave empty: the web UI is
# same-origin through nginx and needs none.
CORS_ORIGINS=

# Files larger than this are skipped, never parsed (hostile-repo protection).
MAX_FILE_BYTES=1000000

# LLM-backed routes (/ask, /impact): calls per user per minute. 0 disables.
LLM_RATE_PER_MIN=20

# Cost bounds. A question stops when it hits its token budget or time limit;
# a user is refused (429) once today's token quota is spent. 0 disables a quota.
DAILY_TOKEN_QUOTA=2000000
AGENT_TOKEN_BUDGET=150000
AGENT_TIMEOUT_S=120
LLM_TIMEOUT_S=60
MAX_QUESTION_CHARS=4000

# Local ML guardrails (api/guard.py, LLM Guard). "required" refuses to start if
# the library is missing; "off" is for local development without the ML stack.
# Threshold 0.99 was measured: 0.92 (library default) flagged 4.6% of ordinary code.
GUARD_MODE=required
GUARD_THRESHOLD=0.99

# Generated code (migrations, protobuf, *.Designer.cs, files headed "auto-generated" or
# "DO NOT EDIT") is not indexed or summarized. Skipped files are counted in the Repos tab,
# and named in impact reports when a commit changes them. 0 = index everything.
INDEX_SKIP_GENERATED=1
# More paths to leave out, as comma-separated globs on the repo-relative path.
# INDEX_EXCLUDE=legacy/*,*_old.py
INDEX_EXCLUDE=

# Remembered conversations ("Remember conversation" in the Ask tab), stored in Neo4j.
SESSION_MAX_TURNS=10              # earlier question/answer pairs sent with each question
SESSION_MAX_HISTORY_CHARS=32000   # about 8,000 tokens; the oldest pairs are dropped first
SESSION_RETENTION_DAYS=30         # conversations quote code; delete them after this

# Repositories added by URL in the Repos tab (api/repo_jobs.py). One index job runs
# at a time, and each user can have one queued or running.
CLONE_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org   # https only; "*" = any public host
CLONE_MAX_MB=1000                 # a larger clone is deleted and refused
INDEX_MAX_SYMBOLS=50000           # refused BEFORE any summary is paid for
# Private repositories: a read-only token, sent only to CLONE_TOKEN_HOST, never stored.
CLONE_TOKEN=
CLONE_TOKEN_HOST=github.com
# CLONE_TOKEN_USER=oauth2         # GitLab; GitHub's default is x-access-token

# Pull request comments (api/pr_review.py). Off unless GITHUB_WEBHOOK_SECRET is set.
# Setup is in RUNBOOK.md. A comment holds symbol ids, signatures and one-line summaries,
# never source or diffs. Uses no LLM.
GITHUB_WEBHOOK_SECRET=
# Which GitHub repos to review, and the indexed repo each one maps to.
# GITHUB_REPOS=my-org/my-service=my-service,my-org/other=other
GITHUB_REPOS=
# Credentials: a GitHub App (preferred), or a token with the same access.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=           # the PEM on one line, with newlines written as \n
GITHUB_TOKEN=
GITHUB_PR_FORKS=0                 # 1 = also review pull requests from forks
PUBLIC_URL=                       # e.g. https://repodigger.example.com, for links in comments

# Neo4j memory. Defaults (4G heap / 2G page cache) suit a large codebase;
# lower them on a small machine.
NEO4J_HEAP=4G
NEO4J_PAGECACHE=2G

# Override or add LLM prices, USD per 1M tokens as [input, output].
# Unlisted models fall back to a placeholder and warn.
# TELEMETRY_PRICING={"my-model": [0.5, 1.5]}
