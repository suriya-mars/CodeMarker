LLM_PROVIDER=anthropic            # or: openai
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_MODEL=                     # set to your current OpenAI model if LLM_PROVIDER=openai (e.g. gpt-4o-mini)
NEO4J_PASSWORD=change-me           # REQUIRED: replace. The api refuses this placeholder.

# Authentication for the HTTP API (api/auth.py).
#   none  - local development only; every route is open
#   token - send "Authorization: Bearer $API_TOKEN" (min 32 chars)
#   alb   - production behind an AWS ALB with Cognito login; set ALB_ARN
AUTH_MODE=none
API_TOKEN=
ALB_ARN=                          # arn:aws:elasticloadbalancing:<region>:<acct>:loadbalancer/app/<name>/<id>
# Exact origins allowed to call the API cross-origin. Leave empty: the web UI is
# same-origin through nginx and needs none.
CORS_ORIGINS=

# Files larger than this are skipped, never parsed (hostile-repo protection).
MAX_FILE_BYTES=1000000

# LLM-backed routes (/ask, /impact): calls per user per minute. 0 disables.
LLM_RATE_PER_MIN=20

# Cost bounds. A question stops when it hits its token budget or time limit;
# a user is refused (429) once today's token quota is spent. 0 disables a quota.
DAILY_TOKEN_QUOTA=2000000
AGENT_TOKEN_BUDGET=150000
AGENT_TIMEOUT_S=120
LLM_TIMEOUT_S=60
MAX_QUESTION_CHARS=4000

# Neo4j memory. Defaults (4G heap / 2G page cache) suit a large codebase;
# lower them on a small machine.
NEO4J_HEAP=4G
NEO4J_PAGECACHE=2G

# Override or add LLM prices, USD per 1M tokens as [input, output].
# Unlisted models fall back to a placeholder and warn.
# TELEMETRY_PRICING={"my-model": [0.5, 1.5]}
