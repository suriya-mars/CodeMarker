LLM_PROVIDER=anthropic            # or: openai
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENAI_MODEL=                     # set to your current OpenAI model if LLM_PROVIDER=openai (e.g. gpt-4o-mini)
NEO4J_PASSWORD=change-me

# Neo4j memory. Defaults (4G heap / 2G page cache) suit a large codebase;
# lower them on a small machine.
NEO4J_HEAP=4G
NEO4J_PAGECACHE=2G

# Override or add LLM prices, USD per 1M tokens as [input, output].
# Unlisted models fall back to a placeholder and warn.
# TELEMETRY_PRICING={"my-model": [0.5, 1.5]}
